# Required in production
NODE_ENV=production
DATA_DIR=/data                 # Railway volume mount path
ADMIN_PHONE=0971234567         # this number becomes admin on sign-up/login

# AI (set one; without either the app runs in demo mode)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Lenco mobile money (payments stay off until set)
LENCO_API_KEY=
LENCO_BASE_URL=https://api.lenco.co/access/v2   # sandbox: https://sandbox.lenco.co/access/v2

# Optional
SESSION_SECRET=                # 32+ chars; auto-generated on the volume if empty
PRICE_WEEKLY=20
PRICE_MONTHLY=60
PRICE_TERM=150
FREE_QUESTIONS_PER_DAY=10
FREE_TUTOR_PER_DAY=5
PAID_QUESTIONS_PER_DAY=200
PAID_TUTOR_PER_DAY=60
